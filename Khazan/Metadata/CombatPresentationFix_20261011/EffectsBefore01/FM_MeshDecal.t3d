   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/BBQ_Material/Decal/FM_MeshDecal.FM_MeshDecal:MaterialExpressionCustom_0'"
      Code="float2 worldScale = float2(length(BasisX), length(BasisY));\nfloat2 footprint = max(min(UnitSize, 5.0 * worldScale), 0.0001);\nfloat2 uv = Local.xy * worldScale / footprint + Offset;\nfloat4 mask = Texture2DSample(Tex, TexSampler, saturate(uv));\nint channel = (int)clamp(floor(Random), 0, 3);\nfloat density = channel == 0 ? mask.r : (channel == 1 ? mask.g : (channel == 2 ? mask.b : max(mask.r, max(mask.g, mask.b))));\nfloat2 p = abs(Local.xy)/2.5;\nfloat radius = saturate(KZBloodProjectionCornerFraction);\nfloat2 q = p-(1.0-radius);\nfloat sd = length(max(q,0.0))+min(max(q.x,q.y),0.0)-radius;\nfloat width = max(fwidth(sd),KZBloodProjectionEdgeFeather);\nfloat volume = 1.0-smoothstep(-width,0.0,sd);\nfloat zdist = abs(Local.z);\nvolume *= 1.0-smoothstep(2.5-max(fwidth(zdist),0.0001),2.5,zdist);\nfloat uvValid = step(0, uv.x) * step(uv.x, 1) * step(0, uv.y) * step(uv.y, 1);\nbool cameraInside = all(abs(CameraLocal) <= 2.5);\nfloat faceValid = cameraInside ? step(Face, 0) : step(0, Face);\nfloat opacity = saturate(density * PC.a) * volume * uvValid * faceValid;\nreturn float4(PC.rgb, opacity);"
      OutputType=CMOT_Float4
      Description="Source-supported projected mesh blood; cooked graph unavailable"
      Inputs(0)=(InputName="Local",Input=(Expression="/Script/Engine.MaterialExpressionTransformPosition'FM_MeshDecal:MaterialExpressionTransformPosition_0'"))
      Inputs(1)=(InputName="CameraLocal",Input=(Expression="/Script/Engine.MaterialExpressionTransformPosition'FM_MeshDecal:MaterialExpressionTransformPosition_1'"))
      Inputs(2)=(InputName="BasisX",Input=(Expression="/Script/Engine.MaterialExpressionTransform'FM_MeshDecal:MaterialExpressionTransform_0'"))
      Inputs(3)=(InputName="BasisY",Input=(Expression="/Script/Engine.MaterialExpressionTransform'FM_MeshDecal:MaterialExpressionTransform_1'"))
      Inputs(4)=(InputName="UnitSize",Input=(Expression="/Script/Engine.MaterialExpressionDynamicParameter'FM_MeshDecal:MaterialExpressionDynamicParameter_0'",Mask=1,MaskR=1))
      Inputs(5)=(InputName="Random",Input=(Expression="/Script/Engine.MaterialExpressionDynamicParameter'FM_MeshDecal:MaterialExpressionDynamicParameter_0'",OutputIndex=1,Mask=1,MaskG=1))
      Inputs(6)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'FM_MeshDecal:MaterialExpressionTextureObjectParameter_0'"))
      Inputs(7)=(InputName="Offset",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_MeshDecal:MaterialExpressionScalarParameter_1'"))
      Inputs(8)=(InputName="PC",Input=(Expression="/Script/Engine.MaterialExpressionParticleColor'FM_MeshDecal:MaterialExpressionParticleColor_2'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      Inputs(9)=(InputName="Face",Input=(Expression="/Script/Engine.MaterialExpressionTwoSidedSign'FM_MeshDecal:MaterialExpressionTwoSidedSign_0'"))
      Inputs(10)=(InputName="KZBloodProjectionCornerFraction",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_MeshDecal:MaterialExpressionScalarParameter_0'"))
      Inputs(11)=(InputName="KZBloodProjectionEdgeFeather",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_MeshDecal:MaterialExpressionScalarParameter_2'"))
      MaterialExpressionEditorX=-1440
      MaterialExpressionEditorY=320
      MaterialExpressionGuid=1F5505EA481B08D0D69BD18CB352F5A3
      Material="/Script/Engine.Material'FM_MeshDecal'"
   End Object
