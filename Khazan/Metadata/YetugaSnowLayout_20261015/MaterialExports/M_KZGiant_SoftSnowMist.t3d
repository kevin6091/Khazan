      Code="float2 uv=frac(UV*float2(max(Columns,1.0),max(Rows,1.0))); float2 p=uv*2.0-1.0; return pow(saturate(1.0-dot(p,p)),2.0)*saturate(Density)*saturate(ParticleAlpha)*saturate(VolumeSupport);"
      OutputType=CMOT_Float1
      Description="TEMP: source density/alpha with atlas support and native spherical extinction. VolumeDensity1 is editable presentation tuning; original shader parity unconfirmed."
