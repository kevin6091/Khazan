   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Monsters/ApesYetuga/GiantPolish/Materials/KZ_FM_Subuv_Atlas_B_3cd87e39.KZ_FM_Subuv_Atlas_B_3cd87e39:MaterialExpressionCustom_0'"
      Code="float2 d=min(UV,1.0-UV); float w=max(Width,max(fwidth(UV.x),fwidth(UV.y))*Pixels); float e=smoothstep(0.0,max(w,0.00001),min(d.x,d.y));return lerp(1.0,e,saturate(Enabled));"
      OutputType=CMOT_Float1
      Description="KZAlphaRepair20261013: inward card feather; TEMP .03 UV / minimum 1.25 pixels; untextured ellipse power2"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'KZ_FM_Subuv_Atlas_B_3cd87e39:MaterialExpressionTextureCoordinate_2'"))
