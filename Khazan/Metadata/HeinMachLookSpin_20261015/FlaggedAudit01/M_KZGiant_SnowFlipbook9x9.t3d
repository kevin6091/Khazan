   Begin Object Name="MaterialExpressionConstant_0" ExportPath="/Script/Engine.MaterialExpressionConstant'/Game/_Art/Effects/Monsters/ApesYetuga/GiantPolish/Materials/M_KZGiant_SnowFlipbook9x9.M_KZGiant_SnowFlipbook9x9:MaterialExpressionConstant_0'"
      R=1.000000
      MaterialExpressionGuid=62605590409E666C62B1F7B8D8BE50B5
      Material="/Script/Engine.Material'M_KZGiant_SnowFlipbook9x9'"
   End Object
   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Monsters/ApesYetuga/GiantPolish/Materials/M_KZGiant_SnowFlipbook9x9.M_KZGiant_SnowFlipbook9x9:MaterialExpressionCustom_0'"
      Code="float2 uv=frac(UV*float2(max(Columns,1.0),max(Rows,1.0))); float2 p=uv*2.0-1.0; return pow(saturate(1.0-dot(p,p)),2.0)*saturate(Density)*saturate(ParticleAlpha)*saturate(VolumeSupport);"
      OutputType=CMOT_Float1
      Description="TEMP: source density/alpha with atlas support and native spherical extinction. VolumeDensity1 is editable presentation tuning; original shader parity unconfirmed."
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'M_KZGiant_SnowFlipbook9x9:MaterialExpressionTextureCoordinate_0'"))
      Inputs(1)=(InputName="Density",Input=(Expression="/Script/Engine.MaterialExpressionCustom'M_KZGiant_SnowFlipbook9x9:MaterialExpressionCustom_1'"))
      Inputs(2)=(InputName="ParticleAlpha",Input=(Expression="/Script/Engine.MaterialExpressionParticleColor'M_KZGiant_SnowFlipbook9x9:MaterialExpressionParticleColor_0'",OutputIndex=4,Mask=1,MaskA=1))
      Inputs(3)=(InputName="Columns",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_KZGiant_SnowFlipbook9x9:MaterialExpressionScalarParameter_0'"))
      Inputs(4)=(InputName="Rows",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_KZGiant_SnowFlipbook9x9:MaterialExpressionScalarParameter_1'"))
      Inputs(5)=(InputName="VolumeSupport",Input=(Expression="/Script/Engine.MaterialExpressionSphericalParticleOpacity'M_KZGiant_SnowFlipbook9x9:MaterialExpressionSphericalParticleOpacity_0'"))
      MaterialExpressionGuid=5DD56C7841B680154CF50A84BE252F2D
      Material="/Script/Engine.Material'M_KZGiant_SnowFlipbook9x9'"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Monsters/ApesYetuga/GiantPolish/Materials/M_KZGiant_SnowFlipbook9x9.M_KZGiant_SnowFlipbook9x9:MaterialExpressionCustom_1'"
      Code="\n// Columns/Rows are the verified source texture layout. Age is the existing particle lifetime fraction.\nfloat2 grid = max(floor(float2(Columns, Rows)), 1.0);\nfloat last = grid.x * grid.y - 1.0;\nfloat frame = saturate(Age) * last;\nfloat first = floor(frame);\nfloat second = min(first + 1.0, last);\nfloat2 uv = saturate(UV);\nfloat2 cell0 = float2(fmod(first, grid.x), floor(first / grid.x));\nfloat2 cell1 = float2(fmod(second, grid.x), floor(second / grid.x));\nfloat a = Texture2DSample(SmokeTexture, SmokeTextureSampler, (cell0 + uv) / grid).r;\nfloat b = Texture2DSample(SmokeTexture, SmokeTextureSampler, (cell1 + uv) / grid).r;\nreturn lerp(a, b, frac(frame));\n"
      OutputType=CMOT_Float1
      Description="9x9 source atlas: one blended smoke frame per existing particle; TEMP normalized-age playback"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'M_KZGiant_SnowFlipbook9x9:MaterialExpressionTextureCoordinate_0'"))
      Inputs(1)=(InputName="Age",Input=(Expression="/Script/Engine.MaterialExpressionParticleRelativeTime'M_KZGiant_SnowFlipbook9x9:MaterialExpressionParticleRelativeTime_0'"))
      Inputs(2)=(InputName="Columns",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_KZGiant_SnowFlipbook9x9:MaterialExpressionScalarParameter_4'"))
      Inputs(3)=(InputName="Rows",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_KZGiant_SnowFlipbook9x9:MaterialExpressionScalarParameter_5'"))
      Inputs(4)=(InputName="SmokeTexture",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_KZGiant_SnowFlipbook9x9:MaterialExpressionTextureObjectParameter_0'"))
      MaterialExpressionGuid=F0E382F740C8D34B5CD6AAA5C7C727B6
      Material="/Script/Engine.Material'M_KZGiant_SnowFlipbook9x9'"
   End Object
