   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/Other/DefaultParticle.DefaultParticle:MaterialExpressionCustom_0'"
      Code="float2 d=min(UV,1.0-UV); float w=max(Width,max(fwidth(UV.x),fwidth(UV.y))*Pixels); float e=smoothstep(0.0,max(w,0.00001),min(d.x,d.y));float2 p=UV*2.0-1.0; e*=pow(saturate(1.0-dot(p,p)),2.0);return lerp(1.0,e,saturate(Enabled));"
      OutputType=CMOT_Float1
      Description="KZAlphaRepair20261013: inward card feather; TEMP .03 UV / minimum 1.25 pixels; untextured ellipse power2"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'DefaultParticle:MaterialExpressionTextureCoordinate_0'"))
      Inputs(1)=(InputName="Width",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'DefaultParticle:MaterialExpressionScalarParameter_1'"))
      Inputs(2)=(InputName="Pixels",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'DefaultParticle:MaterialExpressionScalarParameter_2'"))
      Inputs(3)=(InputName="Enabled",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'DefaultParticle:MaterialExpressionScalarParameter_0'"))
      MaterialExpressionEditorX=700
