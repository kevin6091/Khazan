          "",
          "\tconst VectorRegister4Double Result = VectorAdd(LeftTerm, RightTerm);",
          "\tFQuat4d RotationQuat = FQuat4d::MakeFromVectorRegister(Result);",
          "#else",
          "\tconst double DEG_TO_RAD = UE_DOUBLE_PI / (180.0);",
          "\tconst double RADS_DIVIDED_BY_2 = DEG_TO_RAD / 2.0;",
          "\tdouble SP, SY, SR;",
          "\tdouble CP, CY, CR;",
          "",
          "\tconst double PitchNoWinding = FMath::Fmod(Pitch, 360.0);",
          "\tconst double YawNoWinding = FMath::Fmod(Yaw, 360.0);",
          "\tconst double RollNoWinding = FMath::Fmod(Roll, 360.0);",
          "",
          "\tFMath::SinCos(&SP, &CP, PitchNoWinding * RADS_DIVIDED_BY_2);",
          "\tFMath::SinCos(&SY, &CY, YawNoWinding * RADS_DIVIDED_BY_2);",
          "\tFMath::SinCos(&SR, &CR, RollNoWinding * RADS_DIVIDED_BY_2);",
          "",
          "\tFQuat4d RotationQuat;",
          "\tRotationQuat.X = CR * SP * SY - SR * CP * CY;",
          "\tRotationQuat.Y = -CR * SP * CY - SR * CP * SY;",
          "\tRotationQuat.Z = CR * CP * SY - SR * SP * CY;",
          "\tRotationQuat.W = CR * CP * CY + SR * SP * SY;",
          "#endif // PLATFORM_ENABLE_VECTORINTRINSICS",
