          "UPhysicsAsset* WorldSimulationAsset(USkeletalMesh* Mesh, UPhysicsAsset* Source, const FString& Part)",
          "{",
          "\t// UE 5.8 ref-pose joint creation applies imported bone scale (100) before",
          "\t// RBAN starts at component .01 * root 100 = unit world bone scale.",
          "\t// ImmediatePhysicsAdapters reconstructs geometry at the unit actor scale:",
          "\t// preserve shapes; convert ONLY joint-frame positions by 1 / imported scale.",
          "\tconst FVector ImportedScale = Mesh->GetRefSkeleton().GetRefBonePose()[0].GetScale3D();",
          "\tcheck(ImportedScale.Equals(FVector(ImportedScale.X)) && ImportedScale.X > 0.);",
          "\tconst float UnitConversion = 1.f / ImportedScale.X;",
          "\tconst FString Path = Base + TEXT(\"Meshs/\") + Part + TEXT(\"/Player_Original_\") + Part + TEXT(\"_RigidBody_PhysicsAsset\");",
          "\t// Rebuild from Source on each author pass, never scale an existing result twice.",
          "\tUPhysicsAsset* Result = CastChecked<UPhysicsAsset>(StaticDuplicateObject(Source, CreatePackage(*Path), *FPackageName::GetLongPackageAssetName(Path)));",
          "\tFAssetRegistryModule::AssetCreated(Result);",
          "\tfor (UPhysicsConstraintTemplate* Constraint : Result->ConstraintSetup)",
          "\t{",
          "\t\tConstraint->DefaultInstance.Pos1 *= UnitConversion; Constraint->DefaultInstance.Pos2 *= UnitConversion;",
          "\t\t// These Original constraints have locked linear axes; angular limits, damping",
          "\t\t// and collision-pair policy remain exactly as the component's source asset.",
          "\t}"
        ]
