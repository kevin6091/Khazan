   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/MonsterHuman/FM_Decal_Deferred_D.FM_Decal_Deferred_D:MaterialExpressionCustom_0'"
      Code="// Interpreted polar adapter; original cooked graph/function topology is absent.\n// 2, 1, .5 and 2*pi normalize unit UV/angle; they are mathematical constants.\nfloat2 centered=P2*2.0-1.0;\nfloat radius=length(centered);\n// The unit disk is the mathematical domain of the centered polar adapter.\n// Outside it there is no decal contribution, independently of texture wrap.\nif(radius>=1.0) return float4(0.0,0.0,0.0,0.0);\nfloat angle=atan2(centered.y,centered.x)/6.283185307179586+0.5;\nfloat2 polar=float2(angle,radius);\n// Preserve source tiling/offsets. Exact UV1 wraps back to white UV0 with a\n// Wrap sampler, so clamp to the actual texture\'s outer texel centers.\nuint width,height,awidth,aheight;\nP1.GetDimensions(width,height);\nP7.GetDimensions(awidth,aheight);\nfloat2 halfTexel=0.5/float2(width,height);\nfloat2 ahalfTexel=0.5/float2(awidth,aheight);\nfloat2 uv=clamp(polar*P4.rg+P4.ba,halfTexel,1.0-halfTexel);\nfloat2 auv=clamp(polar*P8.rg+P8.ba,ahalfTexel,1.0-ahalfTexel);\nfloat4 maskSample=Texture2DSample(P1,P1Sampler,uv);\nfloat mask=maskSample.r;\nfloat amask=Texture2DSample(P7,P7Sampler,auv).r;\nfloat opacity=saturate(mask*amask)*P5*P0.a;\n// The generic Param vector RGB-tint interpretation is WITHDRAWN: the\n// original cooked graph is stripped and does not prove that usage.\n// Retain the prior project adapter imageRGB*particleColorRGB without gain;\n// this neutral-color adapter is not proof of the original shader topology.\nfloat3 color=maskSample.rgb*P0.rgb;\nreturn float4(color,opacity);"
      OutputType=CMOT_Float4
      Description="Original parameters/textures; interpreted density, DP dissolve, source UV pan/atlas recovery"
      Inputs(0)=(InputName="P0",Input=(Expression="/Script/Engine.MaterialExpressionConstant4Vector'FM_Decal_Deferred_D:MaterialExpressionConstant4Vector_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      Inputs(1)=(InputName="P1",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'FM_Decal_Deferred_D:MaterialExpressionTextureObjectParameter_0'"))
      Inputs(2)=(InputName="P2",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'FM_Decal_Deferred_D:MaterialExpressionTextureCoordinate_0'"))
      Inputs(3)=(InputName="P3",Input=(Expression="/Script/Engine.MaterialExpressionTime'FM_Decal_Deferred_D:MaterialExpressionTime_0'"))
      Inputs(4)=(InputName="P4",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'FM_Decal_Deferred_D:MaterialExpressionVectorParameter_1'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      Inputs(5)=(InputName="P5",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_Decal_Deferred_D:MaterialExpressionScalarParameter_8'"))
      Inputs(6)=(InputName="P6",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'FM_Decal_Deferred_D:MaterialExpressionVectorParameter_2'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      Inputs(7)=(InputName="P7",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'FM_Decal_Deferred_D:MaterialExpressionTextureObjectParameter_1'"))
      Inputs(8)=(InputName="P8",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'FM_Decal_Deferred_D:MaterialExpressionVectorParameter_0'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      MaterialExpressionEditorX=-520
