   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/MonsterHuman/FM_Decal_Deferred_D.FM_Decal_Deferred_D:MaterialExpressionCustom_1'"
      Code="if(CurveIndex<0 || LifeSpan<=0)return 1;\nif(CurveIndex<0.5){\nfloat t=saturate(max(0,Time-SpawnTime)*TimeScale/max(LifeSpan,0.00001))*3.0;\nif(t<=0.0)return 0.0;\nif(t<1.0){float u=(t-0.0)/1.0;\nfloat u2=u*u,u3=u2*u;return (2*u3-3*u2+1)*0.0+(u3-2*u2+u)*3.1404681+(-2*u3+3*u2)*1.0+(u3-u2)*-0.07961214;\n}\nif(t<1.7){float u=(t-1.0)/0.7;\nfloat u2=u*u,u3=u2*u;return (2*u3-3*u2+1)*1.0+(u3-2*u2+u)*-0.055728497999999994+(-2*u3+3*u2)*0.5+(u3-u2)*-0.35;\n}\nif(t<3.0){float u=(t-1.7)/1.3;\nfloat u2=u*u,u3=u2*u;return (2*u3-3*u2+1)*0.5+(u3-2*u2+u)*-0.65+(-2*u3+3*u2)*0.0+(u3-u2)*0.00378820156;\n}\nreturn 0.0;\n}\nif(CurveIndex<1.5){\nfloat t=saturate(max(0,Time-SpawnTime)*TimeScale/max(LifeSpan,0.00001))*3.0;\nif(t<=0.0)return 0.0;\nif(t<1.2){float u=(t-0.0)/1.2;\nfloat u2=u*u,u3=u2*u;return (2*u3-3*u2+1)*0.0+(u3-2*u2+u)*0.0+(-2*u3+3*u2)*1.0+(u3-u2)*0.382045236;\n}\nif(t<1.5){float u=(t-1.2)/0.30000000000000004;\nreturn lerp(1.0,1.0,u);\n}\nif(t<3.0){float u=(t-1.5)/1.5;\nfloat u2=u*u,u3=u2*u;return (2*u3-3*u2+1)*1.0+(u3-2*u2+u)*-1.80014955+(-2*u3+3*u2)*0.0+(u3-u2)*-0.27573819;\n}\nreturn 0.0;\n}\nif(CurveIndex<2.5){\nfloat t=saturate(max(0,Time-SpawnTime)*TimeScale/max(LifeSpan,0.00001))*3.0;\nif(t<=0.0)return 0.0;\nif(t<0.05){float u=(t-0.0)/0.05;\nreturn lerp(0.0,0.99999994,u);\n}\nif(t<1.0){float u=(t-0.05)/0.95;\nreturn lerp(0.99999994,0.99999994,u);\n}\nif(t<3.0){float u=(t-1.0)/2.0;\nfloat u2=u*u,u3=u2*u;return (2*u3-3*u2+1)*0.99999994+(u3-2*u2+u)*-2.4001994+(-2*u3+3*u2)*0.0+(u3-u2)*-0.36765092;\n}\nreturn 0.0;\n}\nif(CurveIndex<3.5){\nfloat t=saturate(max(0,Time-SpawnTime)*TimeScale/max(LifeSpan,0.00001))*3.0;\nif(t<=0.0)return 0.0;\nif(t<0.1){float u=(t-0.0)/0.1;\nreturn lerp(0.0,1.0,u);\n}\nif(t<2.4){float u=(t-0.1)/2.3;\nreturn lerp(1.0,1.0,u);\n}\nif(t<3.0){float u=(t-2.4)/0.6000000000000001;\nfloat u2=u*u,u3=u2*u;return (2*u3-3*u2+1)*1.0+(u3-2*u2+u)*-0.20689653600000002+(-2*u3+3*u2)*2.8091254e-08+(u3-u2)*-0.0;\n}\nreturn 2.8091254e-08;\n}\nif(CurveIndex<4.5){\nfloat t=saturate(max(0,Time-SpawnTime)*TimeScale/max(LifeSpan,0.00001))*1.0;\nif(t<=0.0)return 0.0;\nif(t<0.01){float u=(t-0.0)/0.01;\nreturn lerp(0.0,0.99999994,u);\n}\nif(t<0.9){float u=(t-0.01)/0.89;\nreturn lerp(0.99999994,1.0,u);\n}\nif(t<1.0){float u=(t-0.9)/0.09999999999999998;\nreturn lerp(1.0,4.4703485e-09,u);\n}\nreturn 4.4703485e-09;\n}\nif(CurveIndex<5.5){\nfloat t=saturate(max(0,Time-SpawnTime)*TimeScale/max(LifeSpan,0.00001))*3.0;\nif(t<=0.0)return 0.0;\nif(t<0.3){float u=(t-0.0)/0.3;\nfloat u2=u*u,u3=u2*u;return (2*u3-3*u2+1)*0.0+(u3-2*u2+u)*0.7584828+(-2*u3+3*u2)*0.8+(u3-u2)*0.095511309;\n}\nif(t<1.5){float u=(t-0.3)/1.2;\nreturn lerp(0.8,0.8,u);\n}\nif(t<3.0){float u=(t-1.5)/1.5;\nfloat u2=u*u,u3=u2*u;return (2*u3-3*u2+1)*0.8+(u3-2*u2+u)*-0.5077569+(-2*u3+3*u2)*0.0+(u3-u2)*-0.27573819;\n}\nreturn 0.0;\n}\nif(CurveIndex<6.5){\nfloat t=saturate(max(0,Time-SpawnTime)*TimeScale/max(LifeSpan,0.00001))*1.0;\nif(t<=0.0)return 1.0;\nif(t<0.5){float u=(t-0.0)/0.5;\nreturn lerp(1.0,1.0,u);\n}\nif(t<1.0){float u=(t-0.5)/0.5;\nreturn lerp(1.0,0.0,u);\n}\nreturn 0.0;\n}\nreturn 1;"
