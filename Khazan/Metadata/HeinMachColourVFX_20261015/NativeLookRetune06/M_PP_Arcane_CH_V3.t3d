   Begin Object Name="MaterialExpressionConstant_1" ExportPath="/Script/Engine.MaterialExpressionConstant'/Game/_RND_ArcanePP/M_PP_Arcane_CH_V3.M_PP_Arcane_CH_V3:MaterialExpressionConstant_1'"
      R=1.000000
      MaterialExpressionEditorX=-1300
