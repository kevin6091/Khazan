   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/MonsterHuman/FM_WPO_Trail_B.FM_WPO_Trail_B:MaterialExpressionCustom_0'"
      Code="float4 pc=P0; float3 image=Texture2DSample(P1,P1Sampler,(P2*float2(P3,P4)+P9*float2(P5,P6)+float2((0+P8),P7))).rgb;\nfloat4 maskSample=Texture2DSample(P10,P10Sampler,(P2*float2(P11,P12)+P9*float2(P13,P14)+float2((0+P8),P15))); float density=max(maskSample.r,max(maskSample.g,maskSample.b));\ndensity=pow(saturate(density),P16);\nfloat opacity=saturate(density-P17)*P18*pc.a;\nfloat3 color=image*float3(1,1,1)*P19*pc.rgb;\nreturn float4(color,opacity);"
