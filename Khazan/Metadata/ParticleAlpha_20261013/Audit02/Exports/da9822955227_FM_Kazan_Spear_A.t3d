   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/Slash/FM_Kazan_Spear_A.FM_Kazan_Spear_A:MaterialExpressionCustom_2'"
      Code="float w=max(Width,0.0001); float2 d=min(UV,1.0-UV); float2 fade=smoothstep(float2(0,0),float2(w,w),d); float q=saturate(UV.y); return Opacity*fade.x*fade.y*(4.0*q*(1.0-q));"
      OutputType=CMOT_Float1
      Description="Raw UV0 boundary feather plus mathematical V bell4q(1-q) multiplies existing MainCurve alpha times bounded ParticleAlpha. Source mesh UV V edges0/1 and center0.5 were verified; bell coefficients are mathematical adapter constants, not source shader code. Highlight alpha remains radiance-only. Added normalized UV width0.10 is assistant temporary tuning to hide source mesh cut boundaries; original shader graph unavailable. All existing source/MI/PS/curve numeric values preserved."
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'FM_Kazan_Spear_A:MaterialExpressionTextureCoordinate_0'"))
      Inputs(1)=(InputName="Opacity",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'FM_Kazan_Spear_A:MaterialExpressionMultiply_4'"))
      Inputs(2)=(InputName="Width",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_Kazan_Spear_A:MaterialExpressionScalarParameter_1'"))
      MaterialExpressionEditorX=-450
      MaterialExpressionEditorY=1200
      MaterialExpressionGuid=AB4A48054C6DE5D8963D04837273DDA7
      Material="/Script/Engine.Material'FM_Kazan_Spear_A'"
