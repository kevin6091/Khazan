   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/Slash/FM_Kazan_Spear_A.FM_Kazan_Spear_A:MaterialExpressionCustom_1'"
      Code="return float2(UV.y*Scale,0.5);"
      OutputType=CMOT_Float2
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'FM_Kazan_Spear_A:MaterialExpressionTextureCoordinate_0'"))
      Inputs(1)=(InputName="Scale",Input=(Expression="/Script/Engine.MaterialExpressionDynamicParameter'FM_Kazan_Spear_A:MaterialExpressionDynamicParameter_0'",OutputIndex=3,Mask=1,MaskA=1))
      MaterialExpressionEditorX=-900
