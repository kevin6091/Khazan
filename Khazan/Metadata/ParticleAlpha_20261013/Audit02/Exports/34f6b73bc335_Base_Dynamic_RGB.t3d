      Code="float2 uv=P0*float2(P1,P2)+float2(P3,0);\nfloat2 noiseUV=P0+P4*float2(P5,P6)+float2(P7,0);\nfloat3 image=Texture2DSample(P8,P8Sampler,uv).rgb; float density=max(image.r,max(image.g,image.b)); float noise=Texture2DSample(P9,P9Sampler,noiseUV).r;\nfloat opacity=saturate(density*pow(max(noise,0),P10))*P11*P12.a;\nreturn float4(image*P12.rgb*P13,opacity);"
