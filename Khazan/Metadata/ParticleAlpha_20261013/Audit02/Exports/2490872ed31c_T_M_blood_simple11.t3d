      Inputs(3)=(InputName="P3",Input=(Expression="/Script/Engine.MaterialExpressionTime'T_M_blood_simple11:MaterialExpressionTime_0'"))
      Inputs(4)=(InputName="P4",Input=(Expression="/Script/Engine.MaterialExpressionDynamicParameter'T_M_blood_simple11:MaterialExpressionDynamicParameter_0'",OutputIndex=2,Mask=1,MaskB=1))
