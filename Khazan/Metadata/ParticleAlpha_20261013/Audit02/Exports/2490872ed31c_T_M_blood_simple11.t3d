   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/MonsterApesYetuga/T_M_blood_simple11.T_M_blood_simple11:MaterialExpressionCustom_0'"
      Code="float4 pc=P0; float3 image=Texture2DSample(P1,P1Sampler,(P2*float2(1,1)+P3*float2(0,0)+float2(0,0))).rgb;\nfloat4 maskSample=Texture2DSample(P1,P1Sampler,(P2*float2(1,1)+P3*float2(0,0)+float2(0,0))); float density=max(maskSample.r,max(maskSample.g,maskSample.b));\ndensity=pow(saturate(density),1);\nfloat opacity=saturate(density-P4)*1*pc.a;\nfloat3 color=image*float3(1,1,1)*1*pc.rgb;\nreturn float4(color,opacity);"
      OutputType=CMOT_Float4
      Description="Original parameters/textures; interpreted density, DP dissolve, source UV pan/atlas recovery"
      Inputs(0)=(InputName="P0",Input=(Expression="/Script/Engine.MaterialExpressionParticleColor'T_M_blood_simple11:MaterialExpressionParticleColor_0'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      Inputs(1)=(InputName="P1",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'T_M_blood_simple11:MaterialExpressionTextureObjectParameter_0'"))
