   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/MonsterHuman/FM_TestTickleParticle.FM_TestTickleParticle:MaterialExpressionCustom_0'"
      Code="float4 pc=P0; float3 image=Texture2DSample(P1,P1Sampler,(((P2*float2(1,1)+P3*float2(0,0)+float2(0,0))+float2(fmod(min(floor(saturate(P4)*max(P5*P6,1)),max(P5*P6-1,0)),max(P5,1)),floor(min(floor(saturate(P4)*max(P5*P6,1)),max(P5*P6-1,0))/max(P5,1))))/max(float2(P5,P6),1))).rgb;\nfloat4 maskSample=Texture2DSample(P1,P1Sampler,(((P2*float2(1,1)+P3*float2(0,0)+float2(0,0))+float2(fmod(min(floor(saturate(P4)*max(P5*P6,1)),max(P5*P6-1,0)),max(P5,1)),floor(min(floor(saturate(P4)*max(P5*P6,1)),max(P5*P6-1,0))/max(P5,1))))/max(float2(P5,P6),1))); float density=max(maskSample.r,max(maskSample.g,maskSample.b));\ndensity=pow(saturate(density),P7);\nfloat opacity=saturate(density-P8)*1*pc.a;\nfloat3 color=image*P9.rgb*1*pc.rgb;\nreturn float4(color,opacity);"
      OutputType=CMOT_Float4
      Description="Original parameters/textures; interpreted density, DP dissolve, source UV pan/atlas recovery"
