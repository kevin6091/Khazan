   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/Smoke/FM_Smoke.FM_Smoke:MaterialExpressionCustom_0'"
      Code="float2 duv=UV*float2(DistU,DistV)+Time*float2(DistUSpeed,DistVSpeed);\nfloat2 distortion=(pow(saturate(Texture2DSample(DistTex,DistTexSampler,duv).rg),DistPow)-0.5)*DistStr;\nfloat2 suv=UV*float2(SubU,SubV)+Time*float2(SubUSpeed,SubVSpeed)+distortion;\nfloat main=pow(saturate(Texture2DSample(MainTex,MainTexSampler,UV).r),MainPow)*MainStr;\nfloat detail=pow(saturate(Texture2DSample(SubTex,SubTexSampler,suv).r),SubPow)*SubStr;\nreturn saturate(main*detail)*saturate(Alpha)*Fade;"
      OutputType=CMOT_Float1
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'FM_Smoke:MaterialExpressionTextureCoordinate_2'"))
      Inputs(1)=(InputName="Time",Input=(Expression="/Script/Engine.MaterialExpressionTime'FM_Smoke:MaterialExpressionTime_2'"))
      Inputs(2)=(InputName="MainTex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'FM_Smoke:MaterialExpressionTextureObjectParameter_0'"))
