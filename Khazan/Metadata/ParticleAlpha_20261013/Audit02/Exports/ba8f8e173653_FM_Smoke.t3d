      Inputs(4)=(InputName="DistTex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'FM_Smoke:MaterialExpressionTextureObjectParameter_2'"))
      Inputs(5)=(InputName="MainPow",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_Smoke:MaterialExpressionScalarParameter_7'"))
      Inputs(6)=(InputName="MainStr",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_Smoke:MaterialExpressionScalarParameter_25'"))
      Inputs(7)=(InputName="SubPow",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_Smoke:MaterialExpressionScalarParameter_34'"))
      Inputs(8)=(InputName="SubStr",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_Smoke:MaterialExpressionScalarParameter_31'"))
      Inputs(9)=(InputName="SubU",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_Smoke:MaterialExpressionScalarParameter_10'"))
      Inputs(10)=(InputName="SubV",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_Smoke:MaterialExpressionScalarParameter_29'"))
