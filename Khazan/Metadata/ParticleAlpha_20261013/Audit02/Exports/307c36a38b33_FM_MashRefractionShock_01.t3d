   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/ShockWave/FM_MashRefractionShock_01.FM_MashRefractionShock_01:MaterialExpressionCustom_0'"
      Code="return UV*float2(TilingU,TilingV)+float2(0,VOffset);"
      OutputType=CMOT_Float2
      Description="Recovery adapter, not original shader wiring. Source Shock parent declares distortion/Refraction and ring texture/scalars/DP channels, but native generic graph erroneously emitted ParticleColor RGB and opacity. Rewire only existing parent: zero emission/opacity, source-masked PixelNormalOffset strength with radial mathematical tangent normal and neutral strength1. RefractionMethod PixelNormalOffset and CoverageIgnored are technical recovery choices; original source method/coverage unavailable. PixelNormalOffset avoids constant large-plane index-of-refraction offsets; project Substrate is enabled and explicit CoverageIgnored permits pure distortion with zero fill opacity. Source UV tiling/DP Voffset, mask R power/strength, DP Ref_str, particle alpha and depth-fade distance remain source inputs. RawUV rather than stripped MF_Tex_PolarCoord_Rad/QualitySwitch is explicit reconstruction. Use_DepthFade default true restores effective source overrides of known03/04/06 children; original parent switch default is unavailable and native children had no switch stored. Existing child values/PS curves/sizes/lifetimes/timings unchanged; no invented strength."
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'FM_MashRefractionShock_01:MaterialExpressionTextureCoordinate_1'"))
      Inputs(1)=(InputName="TilingU",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_MashRefractionShock_01:MaterialExpressionScalarParameter_8'"))
      Inputs(2)=(InputName="TilingV",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_MashRefractionShock_01:MaterialExpressionScalarParameter_3'"))
      Inputs(3)=(InputName="VOffset",Input=(Expression="/Script/Engine.MaterialExpressionDynamicParameter'FM_MashRefractionShock_01:MaterialExpressionDynamicParameter_0'",Mask=1,MaskR=1))
      MaterialExpressionEditorX=-200
      MaterialExpressionEditorY=400
      MaterialExpressionGuid=09A8962F4BAA8B925668D196BE674B84
      Material="/Script/Engine.Material'FM_MashRefractionShock_01'"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/ShockWave/FM_MashRefractionShock_01.FM_MashRefractionShock_01:MaterialExpressionCustom_1'"
      Code="return 1.0+pow(saturate(Mask),MaskPower)*MaskStrength*RefStrength*saturate(ParticleAlpha)*Fade;"
      OutputType=CMOT_Float1
      Description="Recovery adapter, not original shader wiring. Source Shock parent declares distortion/Refraction and ring texture/scalars/DP channels, but native generic graph erroneously emitted ParticleColor RGB and opacity. Rewire only existing parent: zero emission/opacity, source-masked PixelNormalOffset strength with radial mathematical tangent normal and neutral strength1. RefractionMethod PixelNormalOffset and CoverageIgnored are technical recovery choices; original source method/coverage unavailable. PixelNormalOffset avoids constant large-plane index-of-refraction offsets; project Substrate is enabled and explicit CoverageIgnored permits pure distortion with zero fill opacity. Source UV tiling/DP Voffset, mask R power/strength, DP Ref_str, particle alpha and depth-fade distance remain source inputs. RawUV rather than stripped MF_Tex_PolarCoord_Rad/QualitySwitch is explicit reconstruction. Use_DepthFade default true restores effective source overrides of known03/04/06 children; original parent switch default is unavailable and native children had no switch stored. Existing child values/PS curves/sizes/lifetimes/timings unchanged; no invented strength."
      Inputs(0)=(InputName="Mask",Input=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'FM_MashRefractionShock_01:MaterialExpressionTextureSampleParameter2D_1'",OutputIndex=1,Mask=1,MaskR=1))
      Inputs(1)=(InputName="MaskPower",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_MashRefractionShock_01:MaterialExpressionScalarParameter_6'"))
      Inputs(2)=(InputName="MaskStrength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_MashRefractionShock_01:MaterialExpressionScalarParameter_2'"))
      Inputs(3)=(InputName="RefStrength",Input=(Expression="/Script/Engine.MaterialExpressionDynamicParameter'FM_MashRefractionShock_01:MaterialExpressionDynamicParameter_0'",OutputIndex=1,Mask=1,MaskG=1))
      Inputs(4)=(InputName="ParticleAlpha",Input=(Expression="/Script/Engine.MaterialExpressionParticleColor'FM_MashRefractionShock_01:MaterialExpressionParticleColor_0'",OutputIndex=4,Mask=1,MaskA=1))
      Inputs(5)=(InputName="Fade",Input=(Expression="/Script/Engine.MaterialExpressionStaticSwitchParameter'FM_MashRefractionShock_01:MaterialExpressionStaticSwitchParameter_0'"))
      MaterialExpressionEditorX=-200
      MaterialExpressionEditorY=400
      MaterialExpressionGuid=DBBBA0B44C3D5E3658E26BB9FCDD996F
      Material="/Script/Engine.Material'FM_MashRefractionShock_01'"
