   Begin Object Name="MaterialExpressionConstant_1" ExportPath="/Script/Engine.MaterialExpressionConstant'/Game/_Art/Effects/Shared/Materials/ShockWave/FM_MashRefractionShock_01.FM_MashRefractionShock_01:MaterialExpressionConstant_1'"
      MaterialExpressionEditorX=-200
