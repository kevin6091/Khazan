   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Player/Environment/Rendering/HeinMachWeather/M_HM_SourceDust.M_HM_SourceDust:MaterialExpressionCustom_1'"
      Code="float sourceAlpha[8]={0.25,0.32058825035294114,0.3920168370196078,0.46428576,0.4634454236862745,0.3920168370196078,0.32058825035294114,0.25};\n\n// Engine per-view PostProcessVolume flag bit 0 is reserved for covered cave views.\nif (PostVolumeUserFlagTest(0.0)>0.5) return float4(0,0,0,0);\nfloat alphaIndex=saturate(Age)*7.0;\nint first=min((int)alphaIndex,6);\nfloat sourceLifetimeAlpha=lerp(sourceAlpha[first],sourceAlpha[first+1],alphaIndex-first);\nfloat distanceToCamera=length(World.xyz-Camera.xyz);\nfloat nearFade=saturate(distanceToCamera/max(CameraFade,0.001));\nreturn float4(Particle.rgb*Radiance,Mask.r*Particle.a*nearFade*sourceLifetimeAlpha);\n"
      OutputType=CMOT_Float4
      Inputs(0)=(InputName="Mask",Input=(Expression="/Script/Engine.MaterialExpressionTextureSample'M_HM_SourceDust:MaterialExpressionTextureSample_0'",OutputIndex=1,Mask=1,MaskR=1))
      Inputs(1)=(InputName="Particle",Input=(Expression="/Script/Engine.MaterialExpressionParticleColor'M_HM_SourceDust:MaterialExpressionParticleColor_2'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      Inputs(2)=(InputName="World",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'M_HM_SourceDust:MaterialExpressionWorldPosition_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(3)=(InputName="Camera",Input=(Expression="/Script/Engine.MaterialExpressionCameraPositionWS'M_HM_SourceDust:MaterialExpressionCameraPositionWS_2'"))
      Inputs(4)=(InputName="Age",Input=(Expression="/Script/Engine.MaterialExpressionParticleRelativeTime'M_HM_SourceDust:MaterialExpressionParticleRelativeTime_0'"))
      Inputs(5)=(InputName="CameraFade",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_HM_SourceDust:MaterialExpressionScalarParameter_0'"))
      Inputs(6)=(InputName="Radiance",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_HM_SourceDust:MaterialExpressionScalarParameter_4'"))
      MaterialExpressionGuid=20E4A5F444B2F804EF4DD0AED7B9DF0D
      Material="/Script/Engine.Material'M_HM_SourceDust'"
   End Object
   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Player/Environment/Rendering/HeinMachWeather/M_HM_SourceDust.M_HM_SourceDust:MaterialExpressionCustom_2'"
