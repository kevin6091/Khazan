      Inputs(3)=(InputName="Camera",Input=(Expression="/Script/Engine.MaterialExpressionCameraPositionWS'M_HM_SourceSnow:MaterialExpressionCameraPositionWS_4'"))
      Inputs(4)=(InputName="Age",Input=(Expression="/Script/Engine.MaterialExpressionParticleRelativeTime'M_HM_SourceSnow:MaterialExpressionParticleRelativeTime_0'"))
      Inputs(5)=(InputName="CameraFade",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_HM_SourceSnow:MaterialExpressionScalarParameter_0'"))
