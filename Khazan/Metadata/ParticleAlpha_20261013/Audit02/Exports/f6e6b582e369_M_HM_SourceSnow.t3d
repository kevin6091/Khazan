   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Player/Environment/Rendering/HeinMachWeather/M_HM_SourceSnow.M_HM_SourceSnow:MaterialExpressionCustom_0'"
      Code="float sourceAlpha[16]={0.25,0.3488235364705882,0.44764707294117645,0.5492157076470587,0.648039244117647,0.7496078788235294,0.8484314152941176,0.95000005,0.9472549517647059,0.8484314152941176,0.7496078788235294,0.648039244117647,0.5492157076470587,0.44764707294117645,0.3488235364705882,0.25};\n\n// Engine per-view PostProcessVolume flag bit 0 is reserved for covered cave views.\nif (PostVolumeUserFlagTest(0.0)>0.5) return float4(0,0,0,0);\nfloat alphaIndex=saturate(Age)*15.0;\nint first=min((int)alphaIndex,14);\nfloat sourceLifetimeAlpha=lerp(sourceAlpha[first],sourceAlpha[first+1],alphaIndex-first);\nfloat distanceToCamera=length(World.xyz-Camera.xyz);\nfloat nearFade=saturate(distanceToCamera/max(CameraFade,0.001));\nreturn float4(Particle.rgb*Radiance,Mask.r*Particle.a*nearFade*sourceLifetimeAlpha);\n"
      OutputType=CMOT_Float4
      Inputs(0)=(InputName="Mask",Input=(Expression="/Script/Engine.MaterialExpressionTextureSample'M_HM_SourceSnow:MaterialExpressionTextureSample_0'",OutputIndex=1,Mask=1,MaskR=1))
