   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/BBQ_Material/Base/Base_ShockWave_Sprite_001.Base_ShockWave_Sprite_001:MaterialExpressionCustom_0'"
      Code="float2 duv=UV*float2(DistU,DistV);\nfloat2 flow=(Texture2DSample(DistTex,DistTexSampler,duv).rg-0.5)*DistStr;\nfloat2 buv=UV*float2(BaseU,BaseV)+Time*float2(BaseUS,BaseVS)+flow;\nfloat3 base=pow(saturate(Texture2DSample(BaseTex,BaseTexSampler,buv).rgb),BasePow)*BaseMulti;\nfloat mask=pow(saturate(Texture2DSample(MaskTex,MaskTexSampler,UV+flow).r),MaskPow)*MaskMulti;\n// Source Use_2Color/Use_ColorMap/Set_Mat_Color=false: particle color owns tint.\n// Continuous raw-UV support is a technical sprite-volume reconstruction,\n// preventing tiled noise from exposing the finite card\'s square boundary.\nfloat2 q=UV*2.0-1.0;float support=saturate(1.0-dot(q,q));\nreturn float4(base*PC.rgb,saturate(mask)*PC.a*Fade*support*support);"
      OutputType=CMOT_Float4
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'Base_ShockWave_Sprite_001:MaterialExpressionTextureCoordinate_2'"))
      Inputs(1)=(InputName="Time",Input=(Expression="/Script/Engine.MaterialExpressionTime'Base_ShockWave_Sprite_001:MaterialExpressionTime_2'"))
      Inputs(2)=(InputName="BaseTex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'Base_ShockWave_Sprite_001:MaterialExpressionTextureObjectParameter_0'"))
      Inputs(3)=(InputName="MaskTex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'Base_ShockWave_Sprite_001:MaterialExpressionTextureObjectParameter_1'"))
      Inputs(4)=(InputName="DistTex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'Base_ShockWave_Sprite_001:MaterialExpressionTextureObjectParameter_2'"))
      Inputs(5)=(InputName="BaseU",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'Base_ShockWave_Sprite_001:MaterialExpressionScalarParameter_27'"))
      Inputs(6)=(InputName="BaseV",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'Base_ShockWave_Sprite_001:MaterialExpressionScalarParameter_75'"))
      Inputs(7)=(InputName="BaseUS",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'Base_ShockWave_Sprite_001:MaterialExpressionScalarParameter_55'"))
      Inputs(8)=(InputName="BaseVS",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'Base_ShockWave_Sprite_001:MaterialExpressionScalarParameter_4'"))
      Inputs(9)=(InputName="BasePow",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'Base_ShockWave_Sprite_001:MaterialExpressionScalarParameter_48'"))
      Inputs(10)=(InputName="BaseMulti",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'Base_ShockWave_Sprite_001:MaterialExpressionScalarParameter_40'"))
      Inputs(11)=(InputName="MaskPow",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'Base_ShockWave_Sprite_001:MaterialExpressionScalarParameter_110'"))
