      Inputs(15)=(InputName="DistStr",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'Base_ShockWave_Sprite_001:MaterialExpressionScalarParameter_126'"))
      Inputs(16)=(InputName="PC",Input=(Expression="/Script/Engine.MaterialExpressionParticleColor'Base_ShockWave_Sprite_001:MaterialExpressionParticleColor_0'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      Inputs(17)=(InputName="Fade",Input=(Expression="/Script/Engine.MaterialExpressionDepthFade'Base_ShockWave_Sprite_001:MaterialExpressionDepthFade_0'"))
      MaterialExpressionGuid=A911FFE34946679E9786AABC79CE518F
