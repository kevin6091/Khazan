   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/MonsterApesYetuga/FM_FireSubUV_B.FM_FireSubUV_B:MaterialExpressionCustom_0'"
      Code="float4 pc=P0; float3 image=Texture2DSample(P1,P1Sampler,(P2*float2(1,1)+P3*float2(0,0)+float2(0,0))).rgb;\nfloat4 maskSample=Texture2DSample(P1,P1Sampler,(P2*float2(1,1)+P3*float2(0,0)+float2(0,0))); float density=max(maskSample.r,max(maskSample.g,maskSample.b));\ndensity=pow(saturate(density),1);\nfloat opacity=saturate(density-P4)*1*pc.a;\nfloat3 color=image*float3(1,1,1)*1*pc.rgb;\nreturn float4(color,opacity);"
      OutputType=CMOT_Float4
      Description="Original parameters/textures; interpreted density, DP dissolve, source UV pan/atlas recovery"
      Inputs(0)=(InputName="P0",Input=(Expression="/Script/Engine.MaterialExpressionParticleColor'FM_FireSubUV_B:MaterialExpressionParticleColor_0'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      Inputs(1)=(InputName="P1",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'FM_FireSubUV_B:MaterialExpressionTextureObjectParameter_0'"))
      Inputs(2)=(InputName="P2",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'FM_FireSubUV_B:MaterialExpressionTextureCoordinate_0'"))
      Inputs(3)=(InputName="P3",Input=(Expression="/Script/Engine.MaterialExpressionTime'FM_FireSubUV_B:MaterialExpressionTime_0'"))
      Inputs(4)=(InputName="P4",Input=(Expression="/Script/Engine.MaterialExpressionDynamicParameter'FM_FireSubUV_B:MaterialExpressionDynamicParameter_0'",OutputIndex=2,Mask=1,MaskB=1))
      MaterialExpressionEditorX=-520
      MaterialExpressionEditorY=420
      MaterialExpressionGuid=621BFB4E41B07603F5D126A10B3268C3
      Material="/Script/Engine.Material'FM_FireSubUV_B'"
