      Code="float sub=pow(saturate(Sub),max(SubPower,0.00001))*SubStrength; float mask=pow(saturate(Mask),max(MaskPower,0.00001)); float density=saturate(max(0,sub-saturate(Dissolve))*mask*Strength*saturate(Alpha)); if(CutoutThreshold<=0.0) return density; float brightness=(CutoutRGB.r+CutoutRGB.g+CutoutRGB.b)/3.0; float cutout=saturate((brightness-CutoutThreshold)/max(1.0-CutoutThreshold,0.00001)); return density*cutout;"
      OutputType=CMOT_Float1
      Description="Recovery: source smoke density and dissolve; bounded particle alpha before texture mask"
