   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Player/Environment/HeinMach/Reconstructed/TutorialFires/Materials/FM_SubUV_color_B.FM_SubUV_color_B:MaterialExpressionCustom_1'"
      Code="float2 grid=max(float2(Cols,Rows),1); float count=grid.x*grid.y; float f=FracLoop>0.5?frac(Time*Speed+Age)*count:min(Age*count*Speed,count-1); float frame=floor(f); return (UV+float2(fmod(frame,grid.x),floor(frame/grid.x)))/grid;"
      OutputType=CMOT_Float2
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'FM_SubUV_color_B:MaterialExpressionTextureCoordinate_1'"))
      Inputs(1)=(InputName="Age",Input=(Expression="/Script/Engine.MaterialExpressionParticleRelativeTime'FM_SubUV_color_B:MaterialExpressionParticleRelativeTime_2'"))
      Inputs(2)=(InputName="Time",Input=(Expression="/Script/Engine.MaterialExpressionTime'FM_SubUV_color_B:MaterialExpressionTime_0'"))
      Inputs(3)=(InputName="Cols",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_SubUV_color_B:MaterialExpressionScalarParameter_24'"))
      Inputs(4)=(InputName="Rows",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_SubUV_color_B:MaterialExpressionScalarParameter_28'"))
      Inputs(5)=(InputName="Speed",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_SubUV_color_B:MaterialExpressionScalarParameter_52'"))
      Inputs(6)=(InputName="FracLoop",Input=(Expression="/Script/Engine.MaterialExpressionConstant'FM_SubUV_color_B:MaterialExpressionConstant_2'"))
      MaterialExpressionEditorX=-360
      MaterialExpressionEditorY=700
      MaterialExpressionGuid=982C26594563CED22522E6A85FA312A9
      Material="/Script/Engine.Material'FM_SubUV_color_B'"
   End Object
