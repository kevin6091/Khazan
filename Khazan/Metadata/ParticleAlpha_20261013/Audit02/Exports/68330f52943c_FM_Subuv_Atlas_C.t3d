   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/MonsterHuman/FM_Subuv_Atlas_C.FM_Subuv_Atlas_C:MaterialExpressionCustom_0'"
      Code="float4 pc=P0; float3 image=Texture2DSample(P1,P1Sampler,(((P2*float2(1,1)+P3*float2(0,0)+float2(0,0))+float2(fmod(min(floor(saturate(P5)*max(P6*P7,1)),max(P6*P7-1,0)),max(P6,1)),floor(min(floor(saturate(P5)*max(P6*P7,1)),max(P6*P7-1,0))/max(P6,1))))/max(float2(P6,P7),1))).rgb;\nfloat4 maskSample=Texture2DSample(P1,P1Sampler,(((P2*float2(1,1)+P3*float2(0,0)+float2(0,0))+float2(fmod(min(floor(saturate(P5)*max(P6*P7,1)),max(P6*P7-1,0)),max(P6,1)),floor(min(floor(saturate(P5)*max(P6*P7,1)),max(P6*P7-1,0))/max(P6,1))))/max(float2(P6,P7),1))); float density=max(maskSample.r,max(maskSample.g,maskSample.b));\nint channel=(int)floor(saturate(P8)*3.999); density=channel==0?maskSample.r:(channel==1?maskSample.g:(channel==2?maskSample.b:maskSample.a));\ndensity=pow(saturate(density),P9);\nfloat opacity=saturate(density-P10)*P11*pc.a;\nfloat3 color=image*float3(1,1,1)*P12*pc.rgb;\nreturn float4(color,opacity);"
      OutputType=CMOT_Float4
      Description="Original parameters/textures; interpreted density, DP dissolve, source UV pan/atlas recovery"
