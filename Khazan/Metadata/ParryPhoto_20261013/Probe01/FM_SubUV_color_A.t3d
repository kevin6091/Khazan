   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Shared/Materials/SubUV/FM_SubUV_color_A.FM_SubUV_color_A:MaterialExpressionCustom_1'"
      Code="float2 grid=max(float2(Columns,Rows),1); float count=grid.x*grid.y; float frame=min(floor(saturate(Age)*count),count-1); return (UV+float2(fmod(frame,grid.x),floor(frame/grid.x)))/grid;"
      OutputType=CMOT_Float2
      Description="Recovery: source grid, normalized particle age; stripped shader timing is not exact"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'FM_SubUV_color_A:MaterialExpressionTextureCoordinate_1'"))
      Inputs(1)=(InputName="Age",Input=(Expression="/Script/Engine.MaterialExpressionDynamicParameter'FM_SubUV_color_A:MaterialExpressionDynamicParameter_0'",Mask=1,MaskR=1))
      Inputs(2)=(InputName="Columns",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_SubUV_color_A:MaterialExpressionScalarParameter_12'"))
      Inputs(3)=(InputName="Rows",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'FM_SubUV_color_A:MaterialExpressionScalarParameter_16'"))
