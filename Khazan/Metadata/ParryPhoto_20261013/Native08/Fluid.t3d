      Code="float2 d=min(UV,1-UV); float w=max(Width,max(fwidth(UV.x),fwidth(UV.y))*Pixels); return smoothstep(0,max(w,0.00001),min(d.x,d.y));"
      Description="Parry photo TEMP continuous card edge; UV .04/min 1.25 pixels"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'M_FM_fluid_A:MaterialExpressionTextureCoordinate_0'"))
