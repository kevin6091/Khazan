   Begin Object Name="MaterialExpressionCustom_9" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Combat/GuardParry/PlayerParry/Reference/M_FM_fluid_A.M_FM_fluid_A:MaterialExpressionCustom_9'"
      Code="return saturate(Alpha)*Shape*Edge;"
