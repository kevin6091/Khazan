      Code="float2 distUV=P0*float2(P1,P2)+P3*float2(P4,P5)+float2(P6,0);\nfloat2 distortion=(Texture2DSample(P7,P7Sampler,distUV).rg-P8)*P9;\ndistortion*=P10; float2 emiUV=(P0*float2(P11,P12)+P3*float2(P13,P14)+float2(P15,P16))+distortion;\nfloat2 opaUV=(P0*float2(P17,P18)+P3*float2(P19,P20)+float2(P21,P22))+distortion; float mask=1;\nfloat3 densityRGB=Texture2DSample(P23,P23Sampler,opaUV).rgb; float density=pow(saturate(max(densityRGB.r,max(densityRGB.g,densityRGB.b))),P24);\nfloat opacity=saturate(density-P25)*saturate(mask)*P26.a;\n// KZFXRecovery: child243 only; source clamp enum/topology unverified.\nif (P32>0.5) { float2 xy=P0*2.0-1.0; float edge=smoothstep(0.0,max(P33,0.0001),saturate(1.0-dot(xy,xy))); float cameraFade=pow(saturate(P34/max(P35,0.0001)),max(P33,0.0001)); opacity*=edge*cameraFade; }\nfloat3 image=Texture2DSample(P27,P27Sampler,emiUV).rgb; float3 color=(image+P28.rgb*Texture2DSample(P29,P29Sampler,P0).rgb+P30.rgb*density)*P31*P26.rgb; return float4(color,opacity);"
      OutputType=CMOT_Float4
      Description="Source contracts / reconstructed native graph, 2026-10-08"
