   Begin Object Name="MaterialExpressionCustom_6" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Combat/GuardParry/PlayerParry/Reference/M_FM_fluid_A.M_FM_fluid_A:MaterialExpressionCustom_6'"
      Code="return saturate(Alpha)*saturate(Density)*Edge;"
