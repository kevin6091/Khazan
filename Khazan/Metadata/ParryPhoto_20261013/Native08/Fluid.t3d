   Begin Object Name="MaterialExpressionCustom_8" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/_Art/Effects/Combat/GuardParry/PlayerParry/Reference/M_FM_fluid_A.M_FM_fluid_A:MaterialExpressionCustom_8'"
      Code="float2 p=UV*2-1;float r=length(p);float rim=1-smoothstep(.82,1,r);float ring=exp(-pow((r-.72)/.16,2));float core=exp(-5*r*r);return lerp(core,ring,saturate(Role))*rim;"
      OutputType=CMOT_Float1
      Description="Assistant TEMP photo halo reconstruction; analytic circular alpha makes all card corners zero; original 250cm circle extent retained"
