+				Test->TestFalse(TEXT("VictimFront acquires no Knockback/Launch motion task"),RMS.HasActiveRootMotionSources());
+			}
+			if(!Attack->IsActive()&&!Victim->HasMatchingGameplayTag(KZGameplayTags::State_HitReacting))
