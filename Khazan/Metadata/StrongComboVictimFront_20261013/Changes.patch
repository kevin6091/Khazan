+				Test->TestTrue(TEXT("Actual accepted hit was observed during fixed pose"),Checked);
+				const FKZComboNode* Node=Attack->GetComboDefinition()->FindNode(FName(*FString::Printf(TEXT("StrongAttack%02d"),Case%3+1)));
